<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A rede, para acessar os computadores, e o pedido de instalação, para o aplicativo se atualizar. O aplicativo
         não é acessado e não lê arquivos do aparelho. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Do Android 12 em diante, o Ponte se atualiza sem a tela de confirmação do instalador (só a dele mesmo). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Avisar que a atualização terminou ("toque para abrir"): o Android não deixa o Ponte se abrir sozinho. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Girar o aparelho ou abrir o teclado não pode recriar a tela, senão a sessão cairia. -->
        <activity
            android:name=".SessionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:theme="@style/TemaSessao"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <!-- A resposta do Android à instalação da atualização: confirmação, reabrir o Ponte ou o erro. Sem tela. -->
        <activity
            android:name=".AtualizacaoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- A versão nova, recém-instalada pela atualização pedida no aplicativo, avisa por notificação. -->
        <receiver
            android:name=".AtualizadoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Entrega ao instalador do Android o APK da atualização baixada, e só ele. -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
